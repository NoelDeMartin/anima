{
  "name": "@anima/e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:external": "PLAYWRIGHT_MODE=external  UI=true playwright test --ui",
    "dev:managed": "UI=true playwright test --ui",
    "dev:native": "UI=true PLAYWRIGHT_MODE=native PLAYWRIGHT_FRONTEND_URL=http://localhost:1191 playwright test --ui",
    "install-deps": "playwright install --with-deps",
    "test:external": "PLAYWRIGHT_MODE=external playwright test --workers 1",
    "test:managed": "playwright test --workers 1",
    "test:native": "PLAYWRIGHT_MODE=native PLAYWRIGHT_FRONTEND_URL=http://localhost:1191 playwright test --workers 1"
  },
  "devDependencies": {
    "@anima/config": "workspace:*",
    "@noeldemartin/utils": "catalog:",
    "@playwright/test": "^1.58.2",
    "playwright-solid": "next"
  }
}
