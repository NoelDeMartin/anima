{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Ànima",
  "windows": ["*"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/node",
          "sidecar": true,
          "args": true
        },
        {
          "name": "node",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "opener:default"
  ]
}
